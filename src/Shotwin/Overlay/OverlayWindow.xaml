<Window x:Class="Shotwin.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shotwin Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="Black"
        Cursor="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True"
        FlowDirection="LeftToRight">
    <!--
        The one window that never mirrors, whatever the language. It is a frozen copy
        of the desktop drawn at virtual-desktop coordinates, and a mirrored screen is
        one where the cursor lands on the wrong pixels.
    -->
    <!--
        A plain Image over a WriteableBitmap the window paints into itself, not an
        SKElement: that one redraws and re-uploads every pixel on every paint, and at
        desktop size, once per mouse move, that is enough to slow the whole machine.
    -->
    <Grid>
        <Image x:Name="Surface" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
    </Grid>
</Window>
