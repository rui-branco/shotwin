<UserControl x:Class="Shotwin.Shell.RecentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:loc="clr-namespace:Shotwin.Services">
    <UserControl.Resources>
        <!-- One thumbnail card. Selection is a ring, so the image is never tinted. -->
        <Style x:Key="ShotCard" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="9" Background="{StaticResource SurfaceRaised}"
                                BorderBrush="Transparent" BorderThickness="2" Padding="7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" CornerRadius="5" Background="#141417" ClipToBounds="True">
                                    <!--
                                        Pinned left to right: under a right-to-left
                                        language the window mirrors its layout, and a
                                        mirrored screenshot is a wrong screenshot. The
                                        play mark goes the same way, since it points
                                        where the recording runs, not where the text does.
                                    -->
                                    <Grid FlowDirection="LeftToRight">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <!--
                                            A frame of a recording looks exactly like a
                                            screenshot, so the card says which it is.
                                        -->
                                        <Border x:Name="Play" Width="26" Height="26" CornerRadius="13"
                                                Background="#B3000000" Margin="7"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Visibility="Collapsed">
                                            <Path Data="M0,0 L9,5.5 L0,11 Z" Fill="White"
                                                  Width="9" Height="11" Stretch="Uniform"
                                                  Margin="2,0,0,0"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="2,7,2,1">
                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource Muted}" />
                                </StackPanel>

                                <!-- Tick only once something is selected, so the grid stays calm. -->
                                <Border x:Name="Tick" Grid.Row="0" Width="20" Height="20" CornerRadius="10"
                                        Background="{StaticResource Accent}" Margin="6"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="Collapsed">
                                    <Path Data="M0,4.2 L3.2,7.4 L8.6,1.2" Stroke="White" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Width="9" Height="9" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                <Setter TargetName="Play" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A31" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{loc:S RecentTitle}" Style="{StaticResource ViewTitle}" />
                <TextBlock x:Name="FolderLabel" Style="{StaticResource ViewSubtitle}" />
            </StackPanel>
            <Button DockPanel.Dock="Right" x:Name="RevealFolderButton" Style="{StaticResource Chip}"
                    Content="{loc:S RecentOpenFolder}" VerticalAlignment="Top" />
        </DockPanel>

        <!-- Actions for the selection. Disabled until something is picked. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,14">
            <Button x:Name="OpenButton" Style="{StaticResource Chip}" Content="{loc:S RecentEdit}" />
            <Button x:Name="CopyButton" Style="{StaticResource Chip}" Content="{loc:S RecentCopy}" Margin="8,0,0,0" />
            <Button x:Name="PinButton" Style="{StaticResource Chip}" Content="{loc:S RecentPin}" Margin="8,0,0,0" />
            <Button x:Name="RevealButton" Style="{StaticResource Chip}" Content="{loc:S RecentShowInFolder}" Margin="8,0,0,0" />
            <Button x:Name="DeleteButton" Style="{StaticResource Chip}" Content="{loc:S RecentDelete}" Margin="8,0,0,0" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{StaticResource Muted}" FontSize="11.5" />
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,-28,0" Padding="0,0,18,0">
                <ItemsControl x:Name="ShotList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!--
                                A uniform grid rather than a wrap panel: cards stretch to
                                fill the row, so the right edge is flush at any window
                                width instead of leaving a ragged gap.
                            -->
                            <UniformGrid Columns="{Binding Columns,
                                RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource ShotCard}"
                                          Height="{Binding CardHeight,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          PreviewMouseLeftButtonDown="OnCardMouseDown"
                                          MouseDoubleClick="OnCardDoubleClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" MaxWidth="320" Visibility="Collapsed"
                       Text="{loc:S RecentEmpty}" />
        </Grid>
    </Grid>
</UserControl>
