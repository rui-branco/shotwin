<Window x:Class="Shotwin.Shell.FirstRunFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Shotwin.Services"
        Title="Shotwin"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{StaticResource Surface}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ShowInTaskbar="True"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel Margin="28,24,28,22">

            <TextBlock Text="{loc:S SettingsFirstRunTitle}"
                       Style="{StaticResource ViewTitle}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource ViewSubtitle}"
                       Text="{loc:S SettingsFirstRunSubtitle}" />

            <TextBlock Text="{loc:S SettingsFolder}" Margin="0,20,0,5" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="FolderBox" />
                <Button Grid.Column="1" x:Name="BrowseButton" Style="{StaticResource Chip}"
                        Content="{loc:S SettingsBrowse}" Margin="6,0,0,0" />
            </Grid>

            <TextBlock x:Name="Problem" Style="{StaticResource Hint}"
                       Foreground="{StaticResource Warn}" Visibility="Collapsed" />

            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                       Text="{loc:S SettingsFirstRunHint}" />

            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <Button x:Name="UseButton" Style="{StaticResource Primary}"
                        Content="{loc:S SettingsFirstRunUse}" Padding="18,0" />
                <Button x:Name="DefaultButton" Style="{StaticResource Chip}" Height="40"
                        Content="{loc:S SettingsFirstRunDefault}" Margin="8,0,0,0" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
