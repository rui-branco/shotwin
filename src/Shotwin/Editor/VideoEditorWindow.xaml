<Window x:Class="Shotwin.Editor.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Shotwin.Services"
        xmlns:sys="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ed="clr-namespace:Shotwin.Editor"
        Title="Shotwin"
        Background="{StaticResource Surface}"
        WindowStartupLocation="CenterScreen"
        MinWidth="520" MinHeight="320"
        WindowStyle="None"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Same integrated caption as the main window and the editor. -->
    <sys:WindowChrome.WindowChrome>
        <sys:WindowChrome CaptionHeight="38"
                          ResizeBorderThickness="6"
                          CornerRadius="0"
                          GlassFrameThickness="0,0,0,1"
                          UseAeroCaptionButtons="False" />
    </sys:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Chrome" Color="#232327" />

        <!-- Drawn on the same 24x24 grid as the editor's tools, so they match it. -->
        <PathGeometry x:Key="IconPlay" Figures="M7.5,4.8 L19,12 L7.5,19.2 Z" />
        <PathGeometry x:Key="IconPause" Figures="M9.5,5 L9.5,19 M14.5,5 L14.5,19" />
        <!-- A screen: how much of the picture you are actually being shown. -->
        <PathGeometry x:Key="IconDetail"
                      Figures="M3.5,5.5 L20.5,5.5 L20.5,16.5 L3.5,16.5 Z M8.5,20 L15.5,20 M12,16.5 L12,20" />
        <PathGeometry x:Key="IconScissors"
                      Figures="M3,6 A3,3 0 1,1 9,6 A3,3 0 1,1 3,6 Z M3,18 A3,3 0 1,1 9,18 A3,3 0 1,1 3,18 Z M20,4 L8.12,15.88 M14.47,14.48 L20,20 M8.12,8.12 L12,12" />

        <!--
            Icon-only actions, geometry in Tag. Tooltips carry the names, exactly as in
            the editor's toolbar.
        -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- No chrome until you point at it; the glyph is the button. -->
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                            <Path x:Name="Icon" Data="{TemplateBinding Tag}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="16" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  SnapsToDevicePixels="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            One piece of the recording that stays. The clip is built out of these: drag on
            empty track to make another, and what is not covered by one is not in the file.

            The bar is a Thumb so a piece can be slid along the clip, and it takes its own
            clicks — pressing a piece moves it rather than seeking under it.
        -->
        <Style x:Key="PieceBar" TargetType="Thumb">
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="3" Background="#403D8BFD"
                                    BorderBrush="{StaticResource Accent}" BorderThickness="1" />
                            <!-- The bar proper, so a piece reads as a piece of film. -->
                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Margin="1,0,1,0" Background="{StaticResource Accent}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#663D8BFD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The two ends of one piece. -->
        <Style x:Key="PieceHandle" TargetType="Thumb">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" CornerRadius="3" Background="{StaticResource Accent}">
                            <Border Width="1.5" Height="9" CornerRadius="1" Background="#D9FFFFFF"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5AA0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drops a piece. Sits on the bar, above the Thumb, so it takes the press. -->
        <Style x:Key="PieceRemove" TargetType="Button">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Disc" Fill="#CC141417" />
                            <Path Stroke="White" StrokeThickness="1.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Stretch="Uniform" Width="7" Height="7"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M0,0 L10,10 M10,0 L0,10" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="#FF3B30" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Caption: drag band on the left, window buttons on the right. -->
        <Border Grid.Row="0" Background="{StaticResource Chrome}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0">
                    <Path Stroke="{StaticResource Accent}" StrokeThickness="1.9" Stretch="Uniform"
                          Width="14" Height="14" VerticalAlignment="Center"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M6,10 L6,6 L10,6 M18,6 L22,6 L22,10 M22,18 L22,22 L18,22 M10,22 L6,22 L6,18" />
                    <TextBlock x:Name="CaptionTitle" Text="Shotwin" FontSize="12.5"
                               Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="MinimiseButton" Style="{StaticResource CaptionButton}"
                            Height="38" Content="&#xE921;" ToolTip="{loc:S NavMinimise}" />
                    <Button x:Name="MaximiseButton" Style="{StaticResource CaptionButton}"
                            Height="38" Content="&#xE922;" ToolTip="{loc:S NavMaximise}" />
                    <Button x:Name="CaptionCloseButton" Style="{StaticResource CloseButton}"
                            Height="38" Content="&#xE8BB;" ToolTip="{loc:S EditorClose}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--
            Pinned left to right even when the rest of the window mirrors: a mirrored
            recording is a wrong recording, exactly as it is in the editor.
        -->
        <Grid Grid.Row="1" Background="#141417" ClipToBounds="True" FlowDirection="LeftToRight">
            <!--
                Windows' own player, drawing into a child window. Not an Image with frames
                pushed into it: that capped the picture at a quarter size to keep thirty a
                second, and this has no such trade — full size, full rate, hardware decode.
            -->
            <ed:VideoSurface x:Name="Surface" />

            <!--
                In a popup because a child window draws over everything WPF puts on top of
                it. A popup is a window in its own right, so it can sit over the picture;
                anything else here would simply be invisible.
            -->
            <Popup x:Name="PlayOverlay" Placement="Center" PlacementTarget="{Binding ElementName=Surface}"
                   AllowsTransparency="True" StaysOpen="True">
                <Button x:Name="OpenInPlayerButton" Width="64" Height="64"
                        Cursor="Hand" Focusable="False" BorderThickness="0"
                        Background="Transparent" ToolTip="{loc:S VideoPlay}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Disc" Fill="#B4141417" />
                                <Ellipse Stroke="#40FFFFFF" StrokeThickness="1" />
                                <Path Fill="White" Stretch="Uniform" Width="22" Height="22"
                                      Margin="4,0,0,0"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M0,0 L20,11 L0,22 Z" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Disc" Property="Fill" Value="#D2141417" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Popup>
        </Grid>

        <!-- Transport -->
        <Border Grid.Row="2" Background="{StaticResource Chrome}">
            <Grid Margin="12,8,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    Time runs left to right whatever the language does, and every
                    position on this canvas is measured from the track's own left edge,
                    so it is pinned the same way the picture is.
                -->
                <Canvas x:Name="Timeline" Grid.Row="0" Height="40" Background="Transparent"
                        FlowDirection="LeftToRight">
                    <Border x:Name="Track" Height="6" CornerRadius="3" Background="#3A3A44"
                            Canvas.Top="17" />

                    <!--
                        One blue bar per piece that survives the cuts, built as the cuts
                        change. A single bar could only say "from here to here", which is
                        not what a clip with holes in it is: the pieces that stay are the
                        thing to look at, so they are the thing that is drawn.
                    -->
                    <Canvas x:Name="Kept" />
                    <!--
                        Never takes a press: it is two pixels wide and sits on top of the
                        cuts, so it would otherwise swallow clicks meant for them.
                    -->
                    <Border x:Name="Playhead" Width="2" Height="22" CornerRadius="1"
                            IsHitTestVisible="False"
                            Background="{StaticResource Ink}" Canvas.Top="9" />
                </Canvas>

                <DockPanel Grid.Row="1" LastChildFill="False">
                    <!--
                        Play sits here as well as on the picture, because the disc over the
                        frame goes while it plays — leaving nothing to press to stop it.
                        This one stays put and swaps its glyph.
                    -->
                    <Button x:Name="PlayPauseButton" DockPanel.Dock="Left"
                            Style="{StaticResource ActionButton}" Margin="0,0,2,0"
                            Tag="{StaticResource IconPlay}" ToolTip="{loc:S VideoPlay}" />


                    <TextBlock x:Name="PositionText" DockPanel.Dock="Left" VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               FontSize="11.5" Foreground="{StaticResource Muted}" />

                    <Button x:Name="RevealButton" DockPanel.Dock="Right" Style="{StaticResource ActionButton}"
                            Tag="{StaticResource ActFolder}" ToolTip="{loc:S VideoShowInFolder}" />
                    <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource ActionButton}"
                            Tag="{StaticResource ActCopy}" ToolTip="{loc:S VideoCopy}" />
                    <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource ActionButton}"
                            Tag="{StaticResource ActSave}" ToolTip="{loc:S VideoSave}" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="3" Background="{StaticResource Chrome}">
            <DockPanel Margin="12,0">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Foreground="{StaticResource Muted}"
                           FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TrimText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"
                           FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="12,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
