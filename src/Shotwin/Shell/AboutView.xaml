<UserControl x:Class="Shotwin.Shell.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Shotwin.Services">
    <UserControl.Resources>
        <!-- One feature: its name on the left, what it does beside it. -->
        <Style x:Key="FeatureName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="FeatureDetail" TargetType="TextBlock" BasedOn="{StaticResource FeatureName}">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="18,0,0,7" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:S AboutTitle}" Style="{StaticResource ViewTitle}" />
            <TextBlock x:Name="VersionLine" Style="{StaticResource ViewSubtitle}" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="UpdateLine" Style="{StaticResource Hint}" Margin="0"
                           VerticalAlignment="Center" />
                <Button x:Name="CheckAgainButton" Style="{StaticResource Chip}"
                        Content="{loc:S AboutCheckAgain}" Height="26" FontSize="11" Padding="10,0"
                        Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Margin="0,18,-28,0" Padding="0,0,28,0">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <TextBlock Style="{StaticResource Hint}" Margin="0" FontSize="12"
                               Text="{loc:S AboutSummary}" />
                </Border>

                <TextBlock Text="{loc:S AboutCaptureHeader}" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="128" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:S AboutCaptureArea}" Style="{StaticResource FeatureName}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FeatureDetail}"
                               Text="{loc:S AboutCaptureAreaDetail}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:S AboutCaptureScreen}" Style="{StaticResource FeatureName}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FeatureDetail}"
                               Text="{loc:S AboutCaptureScreenDetail}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:S AboutCaptureScrolling}" Style="{StaticResource FeatureName}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FeatureDetail}"
                               Text="{loc:S AboutCaptureScrollingDetail}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:S AboutCaptureText}" Style="{StaticResource FeatureName}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FeatureDetail}"
                               Text="{loc:S AboutCaptureTextDetail}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:S AboutCaptureColour}" Style="{StaticResource FeatureName}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FeatureDetail}"
                               Text="{loc:S AboutCaptureColourDetail}" />
                </Grid>

                <TextBlock Text="{loc:S AboutEditorHeader}" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="128" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:S AboutEditorAnnotate}" Style="{StaticResource FeatureName}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FeatureDetail}"
                               Text="{loc:S AboutEditorAnnotateDetail}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:S AboutEditorRedact}" Style="{StaticResource FeatureName}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FeatureDetail}"
                               Text="{loc:S AboutEditorRedactDetail}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:S AboutEditorCompose}" Style="{StaticResource FeatureName}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FeatureDetail}"
                               Text="{loc:S AboutEditorComposeDetail}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:S AboutEditorPin}" Style="{StaticResource FeatureName}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FeatureDetail}"
                               Text="{loc:S AboutEditorPinDetail}" />
                </Grid>

                <TextBlock Text="{loc:S AboutAroundHeader}" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0"
                           Text="{loc:S AboutAroundDetail}" />
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
