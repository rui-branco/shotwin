<Window x:Class="Shotwin.Preview.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Shotwin.Services"
        Title="Shotwin preview"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="PreviewAction" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#E7E7EA" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                            <Grid>
                                <!-- Tag holds a drawn Geometry; without one this falls back to the icon font. -->
                                <TextBlock x:Name="Glyph" Visibility="Collapsed"
                                           Text="{TemplateBinding Content}"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="14"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="Icon" Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform" Width="15" Height="15"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D8BFD" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Layered window: WPF composites this, so the Border is the corner. -->
    <Border Margin="16" CornerRadius="8" Background="#1B1B1F"
            BorderBrush="#4DFFFFFF" BorderThickness="1" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                The shot is the Border's Background, not an Image inside it. ClipToBounds
                clips to the rectangle, not the rounded geometry, so a hosted Image kept
                punching square corners through the top of the card.

                BitmapScalingMode belongs on the Border, not on the ImageBrush: it is an
                attached property read off the Visual being rendered, and a Brush is not a
                Visual, so setting it there silently does nothing and the shot gets the
                default blurry downscale.
            -->
            <!--
                One fixed tile, always: both dimensions are pinned here rather than left to
                the action bar below, so the card stays the same size whether or not every
                action is offered, and does not resize itself around whatever was grabbed.

                UniformToFill rather than Uniform: fitting a shot of any shape into a fixed
                box means either cropping it or padding it, and letterbox bands around a
                tall capture look like a rendering fault. Anchored to the top, because the
                top-left is where the content of a screenshot almost always starts.
            -->
            <!-- Pinned left to right: a mirrored thumbnail is a wrong thumbnail. -->
            <Border x:Name="ThumbFrame" Grid.Row="0" Width="278" Height="150" FlowDirection="LeftToRight"
                    CornerRadius="7,7,0,0" Background="#141417"
                    RenderOptions.BitmapScalingMode="HighQuality">
                <Border x:Name="ThumbFill" CornerRadius="7,7,0,0">
                    <Border.Background>
                        <ImageBrush x:Name="ThumbBrush" Stretch="UniformToFill"
                                    AlignmentX="Center" AlignmentY="Top" />
                    </Border.Background>
                </Border>
            </Border>

            <!-- Always visible: the thumbnail is a staging area, so its verbs are on it. -->
            <Border Grid.Row="1" Background="#212126" Padding="6,7" CornerRadius="0,0,7,7">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="EditButton" Style="{StaticResource PreviewAction}"
                            Content="&#xE70F;" ToolTip="{loc:S PreviewEdit}" />
                    <Button x:Name="CopyButton" Style="{StaticResource PreviewAction}"
                            Content="&#xE8C8;" ToolTip="{loc:S PreviewCopy}" />
                    <Button x:Name="OcrButton" Style="{StaticResource PreviewAction}"
                            Tag="{StaticResource ActOcr}" ToolTip="{loc:S PreviewOcr}" />
                    <Button x:Name="SaveButton" Style="{StaticResource PreviewAction}"
                            Content="&#xE74E;" ToolTip="{loc:S PreviewSave}" />
                    <Button x:Name="PinButton" Style="{StaticResource PreviewAction}"
                            Content="&#xE718;" ToolTip="{loc:S PreviewPin}" />
                    <Button x:Name="FolderButton" Style="{StaticResource PreviewAction}"
                            Content="&#xE838;" ToolTip="{loc:S PreviewShowInFolder}" />
                    <Button x:Name="DismissButton" Style="{StaticResource PreviewAction}"
                            Content="&#xE711;" ToolTip="{loc:S PreviewDismiss}" />
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
