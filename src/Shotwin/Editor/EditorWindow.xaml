<Window x:Class="Shotwin.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:loc="clr-namespace:Shotwin.Services"
        xmlns:sys="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Shotwin"
        Background="{StaticResource Surface}"
        WindowStartupLocation="CenterScreen"
        MinWidth="520" MinHeight="320"
        WindowStyle="None"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Same integrated caption as the main window. -->
    <sys:WindowChrome.WindowChrome>
        <sys:WindowChrome CaptionHeight="38"
                          ResizeBorderThickness="6"
                          CornerRadius="0"
                          GlassFrameThickness="0,0,0,1"
                          UseAeroCaptionButtons="False" />
    </sys:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Chrome" Color="#232327" />
        <SolidColorBrush x:Key="Ink" Color="#E7E7EA" />
        <SolidColorBrush x:Key="Muted" Color="#8A8A93" />
        <SolidColorBrush x:Key="Accent" Color="#3D8BFD" />

        <!--
            Tool icons. All drawn on a 24x24 grid as pure outlines with no fills, so a
            single stroked Path template renders every one of them and they stay
            optically consistent at any size.
        -->
        <PathGeometry x:Key="IconSelect" Figures="M5,3 L5,19 L9.2,15.2 L11.8,20.5 L14,19.5 L11.5,14.4 L18,13.8 Z" />
        <PathGeometry x:Key="IconArrow" Figures="M5,19 L19,5 M19,5 L19,11.5 M19,5 L12.5,5" />
        <PathGeometry x:Key="IconRect" Figures="M6.5,5 L17.5,5 A2.5,2.5 0 0 1 20,7.5 L20,16.5 A2.5,2.5 0 0 1 17.5,19 L6.5,19 A2.5,2.5 0 0 1 4,16.5 L4,7.5 A2.5,2.5 0 0 1 6.5,5 Z" />
        <PathGeometry x:Key="IconEllipse" Figures="M4,12 A8,7 0 1 0 20,12 A8,7 0 1 0 4,12 Z" />
        <PathGeometry x:Key="IconLine" Figures="M4.5,19.5 L19.5,4.5" />
        <PathGeometry x:Key="IconPen" Figures="M4,20 L4.5,16 L16,4.5 L19.5,8 L8,19.5 Z M14,6.5 L17.5,10" />
        <PathGeometry x:Key="IconHighlight" Figures="M7,15.5 L14.5,8 L18,11.5 L10.5,19 L6.5,19 Z M4,21.5 L20,21.5" />
        <PathGeometry x:Key="IconText" Figures="M5,6 L19,6 M12,6 L12,19 M9,19 L15,19" />
        <PathGeometry x:Key="IconStep" Figures="M3.5,12 A8.5,8.5 0 1 0 20.5,12 A8.5,8.5 0 1 0 3.5,12 Z M10.5,9.8 L12.3,8.5 L12.3,16 M10.4,16 L14.2,16" />
        <PathGeometry x:Key="IconPixelate" Figures="M4,4 L20,4 L20,20 L4,20 Z M4,9.33 L20,9.33 M4,14.67 L20,14.67 M9.33,4 L9.33,20 M14.67,4 L14.67,20" />
        <PathGeometry x:Key="IconCrop" Figures="M7,2.5 L7,17 L21.5,17 M2.5,7 L17,7 L17,21.5" />
        <PathGeometry x:Key="IconCut" Figures="M6.5,18.3 A2.6,2.6 0 1 0 6.51,18.3 Z M17.5,18.3 A2.6,2.6 0 1 0 17.51,18.3 Z M8.4,16.5 L18,3.5 M15.6,16.5 L6,3.5" />
        <PathGeometry x:Key="IconBlur" Figures="M12,3.5 C12,3.5 5.5,11 5.5,14.8 A6.5,6.5 0 0 0 18.5,14.8 C18.5,11 12,3.5 12,3.5 Z" />

        <Style x:Key="ToolButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                            <Path x:Name="Icon"
                                  Data="{TemplateBinding Tag}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.55"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="17" Height="17"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  SnapsToDevicePixels="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Icon-only actions in Segoe Fluent Icons, the shipped Windows icon font, so
            Undo/Pin/Copy/Save read the same here as everywhere else in the OS. Tooltips
            carry the names and the shortcuts.
        -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- No chrome until you point at it; the glyph is the button. -->
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                            <Grid>
                                <!--
                                    Tag carries a drawn Geometry for the few actions the
                                    icon font has no honest glyph for; everything else
                                    stays on Segoe Fluent and takes the Tag-is-null path.
                                -->
                                <TextBlock x:Name="Glyph" Visibility="Collapsed"
                                           Text="{TemplateBinding Content}"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="14"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="Icon" Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="0" />
                            <Ellipse Fill="{TemplateBinding Background}" Margin="3" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <!-- Auto, so the toolbar can take a second line instead of hiding tools. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!--
            Caption: drag band on the left, window buttons on the right. Same brush as
            the toolbar below it, so the two rows read as one chrome surface instead of
            a title bar sitting on top of the app.
        -->
        <Border Grid.Row="0" Background="{StaticResource Chrome}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0">
                    <Path Stroke="{StaticResource Accent}" StrokeThickness="1.9" Stretch="Uniform"
                          Width="14" Height="14" VerticalAlignment="Center"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M6,10 L6,6 L10,6 M18,6 L22,6 L22,10 M22,18 L22,22 L18,22 M10,22 L6,22 L6,18" />
                    <TextBlock x:Name="CaptionTitle" Text="Shotwin" FontSize="12.5"
                               Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="MinimiseButton" Style="{StaticResource CaptionButton}"
                            Height="38" Content="&#xE921;" ToolTip="{loc:S NavMinimise}" />
                    <Button x:Name="MaximiseButton" Style="{StaticResource CaptionButton}"
                            Height="38" Content="&#xE922;" ToolTip="{loc:S NavMaximise}" />
                    <Button x:Name="CaptionCloseButton" Style="{StaticResource CloseButton}"
                            Height="38" Content="&#xE8BB;" ToolTip="{loc:S EditorClose}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource Chrome}" MinHeight="46">
            <DockPanel LastChildFill="True" Margin="8,0">
                <!--
                    Actions are declared first on purpose. A DockPanel gives space to
                    whichever child is docked first, so with the tools leading, Copy and
                    Save were simply pushed off the right edge on a narrow window with
                    no way to reach them.
                -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AddImageButton" Style="{StaticResource ActionButton}" Content="&#xE710;"
                            ToolTip="{loc:S EditorAddImage, Arg=Ctrl+Shift+A, Arg2=Ctrl+V}" />
                    <Button x:Name="OcrButton" Style="{StaticResource ActionButton}"
                            Tag="{StaticResource ActOcr}"
                            ToolTip="{loc:S EditorOcr, Arg=Ctrl+Shift+T}" />
                    <Button x:Name="UndoButton" Style="{StaticResource ActionButton}" Content="&#xE7A7;"
                            ToolTip="{loc:S EditorUndo, Arg=Ctrl+Z}" />
                    <Button x:Name="PinButton" Style="{StaticResource ActionButton}" Content="&#xE718;"
                            ToolTip="{loc:S EditorPin, Arg=Ctrl+P}" />
                    <Button x:Name="CopyButton" Style="{StaticResource ActionButton}" Content="&#xE8C8;"
                            ToolTip="{loc:S EditorCopy, Arg=Ctrl+C}" />
                    <Button x:Name="SaveButton" Style="{StaticResource ActionButton}" Content="&#xE74E;"
                            ToolTip="{loc:S EditorSave, Arg=Ctrl+S}" />
                </StackPanel>

                <!--
                    Tools take the width that is left and wrap onto another line when it
                    runs out. As the DockPanel's fill child it is given a real width to
                    measure against, which is what a WrapPanel needs to wrap at all.
                -->
                <WrapPanel x:Name="ToolStrip" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="ToolSelect" Style="{StaticResource ToolButton}" Tag="{StaticResource IconSelect}" ToolTip="{loc:S EditorToolSelect, Arg=V}" />
                    <ToggleButton x:Name="ToolArrow" Style="{StaticResource ToolButton}" Tag="{StaticResource IconArrow}" ToolTip="{loc:S EditorToolArrow, Arg=A}" />
                    <ToggleButton x:Name="ToolRect" Style="{StaticResource ToolButton}" Tag="{StaticResource IconRect}" ToolTip="{loc:S EditorToolRectangle, Arg=R}" />
                    <ToggleButton x:Name="ToolEllipse" Style="{StaticResource ToolButton}" Tag="{StaticResource IconEllipse}" ToolTip="{loc:S EditorToolEllipse, Arg=O}" />
                    <ToggleButton x:Name="ToolLine" Style="{StaticResource ToolButton}" Tag="{StaticResource IconLine}" ToolTip="{loc:S EditorToolLine, Arg=L}" />
                    <ToggleButton x:Name="ToolPen" Style="{StaticResource ToolButton}" Tag="{StaticResource IconPen}" ToolTip="{loc:S EditorToolPen, Arg=P}" />
                    <ToggleButton x:Name="ToolHighlight" Style="{StaticResource ToolButton}" Tag="{StaticResource IconHighlight}" ToolTip="{loc:S EditorToolHighlight, Arg=H}" />
                    <ToggleButton x:Name="ToolText" Style="{StaticResource ToolButton}" Tag="{StaticResource IconText}" ToolTip="{loc:S EditorToolText, Arg=T}" />
                    <ToggleButton x:Name="ToolStep" Style="{StaticResource ToolButton}" Tag="{StaticResource IconStep}" ToolTip="{loc:S EditorToolStep, Arg=S}" />
                    <ToggleButton x:Name="ToolPixelate" Style="{StaticResource ToolButton}" Tag="{StaticResource IconPixelate}" ToolTip="{loc:S EditorToolPixelate, Arg=B}" />
                    <ToggleButton x:Name="ToolBlur" Style="{StaticResource ToolButton}" Tag="{StaticResource IconBlur}" ToolTip="{loc:S EditorToolBlur, Arg=Shift+B}" />
                    <ToggleButton x:Name="ToolCrop" Style="{StaticResource ToolButton}" Tag="{StaticResource IconCrop}" ToolTip="{loc:S EditorToolCrop, Arg=C}" />
                    <ToggleButton x:Name="ToolCut" Style="{StaticResource ToolButton}" Tag="{StaticResource IconCut}" ToolTip="{loc:S EditorToolCut, Arg=K}" />

                    <Border Width="1" Background="#33FFFFFF" Margin="8,7" />

                    <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center" />

                    <Border Width="1" Background="#33FFFFFF" Margin="8,7" />

                    <TextBlock Text="{loc:S EditorSize}" Foreground="{StaticResource Muted}" FontFamily="Segoe UI" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider x:Name="StrokeSlider" Width="84" Minimum="1" Maximum="24" Value="4"
                            VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Canvas -->
        <!--
            Pinned left to right even when the rest of the window mirrors. The shot
            itself must never be flipped, and every annotation coordinate â€” including
            the Canvas.Left the text box is placed at â€” is measured from the image's
            own left edge.
        -->
        <Grid Grid.Row="2" Background="#141417" ClipToBounds="True" FlowDirection="LeftToRight">
            <skia:SKElement x:Name="Surface" PaintSurface="OnPaintSurface" />
            <Canvas x:Name="EditLayer" Background="Transparent" IsHitTestVisible="False">
                <TextBox x:Name="TextEntry"
                         Visibility="Collapsed"
                         Background="#CC000000"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#3D8BFD"
                         BorderThickness="1"
                         AcceptsReturn="True"
                         FontFamily="Segoe UI"
                         FontWeight="Bold"
                         MinWidth="120"
                         Padding="4,2" />
            </Canvas>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Background="{StaticResource Chrome}">
            <DockPanel Margin="10,0">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Foreground="{StaticResource Muted}"
                           FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"
                           FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
