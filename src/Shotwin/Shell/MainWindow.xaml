<Window x:Class="Shotwin.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Shotwin.Shell"
        xmlns:loc="clr-namespace:Shotwin.Services"
        xmlns:sys="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Shotwin"
        Width="880" Height="600"
        MinWidth="760" MinHeight="520"
        Background="{StaticResource Surface}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        WindowChrome removes the system title bar while keeping everything Windows gives
        you for free: snap layouts, drag-to-move, double-click to maximise, the resize
        border and the taskbar preview. AllowsTransparency stays off, or all of that
        goes away and the window renders in software.
    -->
    <sys:WindowChrome.WindowChrome>
        <sys:WindowChrome CaptionHeight="42"
                          ResizeBorderThickness="6"
                          CornerRadius="0"
                          GlassFrameThickness="0,0,0,1"
                          UseAeroCaptionButtons="False" />
    </sys:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Nav icons, 24x24 outlines to match the editor toolbar. -->
        <PathGeometry x:Key="NavCapture" Figures="M6,9.5 L6,6 L9.5,6 M18,6 L21.5,6 L21.5,9.5 M21.5,18 L21.5,21.5 L18,21.5 M9.5,21.5 L6,21.5 L6,18 M11,11 L17,11 L17,17 L11,17 Z" />
        <PathGeometry x:Key="NavRecent" Figures="M4,6.5 L20,6.5 L20,19 L4,19 Z M4,15 L9,11 L13.5,15 L16.5,12.5 L20,15.5 M15.5,10.5 A1.3,1.3 0 1 0 15.51,10.5 Z" />
        <PathGeometry x:Key="NavShortcuts" Figures="M3.5,7 L20.5,7 L20.5,17 L3.5,17 Z M7,10.5 L7.01,10.5 M10.5,10.5 L10.51,10.5 M14,10.5 L14.01,10.5 M17.5,10.5 L17.51,10.5 M8,13.8 L16,13.8" />
        <PathGeometry x:Key="NavSettings" Figures="M12,8.6 A3.4,3.4 0 1 0 12.01,8.6 Z M19.4,14.2 A1.6,1.6 0 0 0 19.7,16 L19.8,16.1 A1.9,1.9 0 1 1 17.1,18.8 L17,18.7 A1.6,1.6 0 0 0 15.2,18.4 A1.6,1.6 0 0 0 14.2,19.9 L14.2,20.1 A1.9,1.9 0 1 1 10.4,20.1 L10.4,20 A1.6,1.6 0 0 0 9.3,18.5 A1.6,1.6 0 0 0 7.5,18.8 L7.4,18.9 A1.9,1.9 0 1 1 4.7,16.2 L4.8,16.1 A1.6,1.6 0 0 0 5.1,14.3 A1.6,1.6 0 0 0 3.6,13.3 L3.4,13.3 A1.9,1.9 0 1 1 3.4,9.5 L3.5,9.5 A1.6,1.6 0 0 0 5,8.4 A1.6,1.6 0 0 0 4.7,6.6 L4.6,6.5 A1.9,1.9 0 1 1 7.3,3.8 L7.4,3.9 A1.6,1.6 0 0 0 9.2,4.2 A1.6,1.6 0 0 0 10.2,2.7 L10.2,2.5 A1.9,1.9 0 1 1 14,2.5 L14,2.6 A1.6,1.6 0 0 0 15,4.1 A1.6,1.6 0 0 0 16.8,3.8 L16.9,3.7 A1.9,1.9 0 1 1 19.6,6.4 L19.5,6.5 A1.6,1.6 0 0 0 19.2,8.3 L19.2,8.4 A1.6,1.6 0 0 0 20.7,9.4 L20.9,9.4 A1.9,1.9 0 1 1 20.9,13.2 L20.8,13.2 A1.6,1.6 0 0 0 19.4,14.2 Z" />
        <PathGeometry x:Key="NavAbout" Figures="M12,3.5 A8.5,8.5 0 1 0 12.01,3.5 Z M12,11 L12,16.5 M12,7.8 L12.01,7.8" />

    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- Matches WindowChrome.CaptionHeight, so the drag band and the row agree. -->
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Navigation rail, running the full height including the caption band -->
        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource Rail}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Height="42" Margin="16,0,16,16">
                    <Border Width="28" Height="28" CornerRadius="7" Background="#26262B">
                        <Path Stroke="{StaticResource Accent}" StrokeThickness="1.9" Stretch="Uniform"
                              Width="17" Height="17"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M6,10 L6,6 L10,6 M18,6 L22,6 L22,10 M22,18 L22,22 L18,22 M10,22 L6,22 L6,18" />
                    </Border>
                    <TextBlock Text="Shotwin" FontSize="14.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavCaptureItem" Style="{StaticResource NavItem}"
                                 Tag="{StaticResource NavCapture}" Content="{loc:S NavCapture}" GroupName="Nav" IsChecked="True" />
                    <RadioButton x:Name="NavRecentItem" Style="{StaticResource NavItem}"
                                 Tag="{StaticResource NavRecent}" Content="{loc:S NavRecent}" GroupName="Nav" />
                    <RadioButton x:Name="NavShortcutsItem" Style="{StaticResource NavItem}"
                                 Tag="{StaticResource NavShortcuts}" Content="{loc:S NavShortcuts}" GroupName="Nav" />
                    <RadioButton x:Name="NavSettingsItem" Style="{StaticResource NavItem}"
                                 Tag="{StaticResource NavSettings}" Content="{loc:S NavSettings}" GroupName="Nav" />
                    <RadioButton x:Name="NavAboutItem" Style="{StaticResource NavItem}"
                                 Tag="{StaticResource NavAbout}" Content="{loc:S NavAbout}" GroupName="Nav" />
                </StackPanel>

                <!--
                    The version sits here quietly, and is the same spot the update offers
                    itself from when there is one: a found build turns the label into a
                    button rather than interrupting anything.
                -->
                <StackPanel Grid.Row="2" Margin="16,12,16,14">
                    <TextBlock x:Name="VersionLabel" Style="{StaticResource Hint}"
                               FontSize="11" Margin="0" />
                    <Button x:Name="UpdateButton" Style="{StaticResource Chip}"
                            Height="26" FontSize="11" Padding="10,0"
                            HorizontalAlignment="Left" Visibility="Collapsed" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- Caption buttons, in the drag band so the rest of it stays draggable -->
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="MinimiseButton" Style="{StaticResource CaptionButton}"
                    Content="&#xE921;" ToolTip="{loc:S NavMinimise}" />
            <Button x:Name="MaximiseButton" Style="{StaticResource CaptionButton}"
                    Content="&#xE922;" ToolTip="{loc:S NavMaximise}" />
            <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="{loc:S NavCloseToTray}" />
        </StackPanel>

        <!-- Content. One view visible at a time; all of them stay alive so state persists. -->
        <!--
            No bottom margin: a scrolling page should run to the window edge. Pages that
            need clearance add it inside themselves, where it scrolls with the content
            instead of sitting there as a permanent strip of dead space.
        -->
        <Grid Grid.Column="1" Grid.Row="1" Margin="28,6,28,0">
            <shell:CaptureView x:Name="CapturePage" />
            <shell:RecentView x:Name="RecentPage" Visibility="Collapsed" />
            <shell:ShortcutsView x:Name="ShortcutsPage" Visibility="Collapsed" />
            <shell:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
            <shell:AboutView x:Name="AboutPage" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
