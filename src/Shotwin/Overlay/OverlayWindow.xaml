<Window x:Class="Shotwin.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Shotwin Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="Black"
        Cursor="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True"
        FlowDirection="LeftToRight">
    <!--
        The one window that never mirrors, whatever the language. It is a frozen copy
        of the desktop drawn at virtual-desktop coordinates, and a mirrored screen is
        one where the cursor lands on the wrong pixels.
    -->
    <Grid>
        <skia:SKElement x:Name="Surface" PaintSurface="OnPaintSurface" />
    </Grid>
</Window>
