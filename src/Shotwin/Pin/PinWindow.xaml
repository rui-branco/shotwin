<Window x:Class="Shotwin.Pin.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Shotwin.Services"
        Title="{loc:S PinTitle}"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="MenuCopy" Header="{loc:S PinCopy}" InputGestureText="Ctrl+C" />
            <MenuItem x:Name="MenuSave" Header="{loc:S PinSave}" InputGestureText="Ctrl+S" />
            <Separator />
            <!-- Header written from code: it reads back the other way once faded. -->
            <MenuItem x:Name="MenuOpacity" />
            <MenuItem x:Name="MenuClickThrough" Header="{loc:S PinClickThrough}" IsCheckable="True" />
            <MenuItem x:Name="MenuResetZoom" Header="{loc:S PinActualSize}" InputGestureText="Ctrl+0" />
            <Separator />
            <MenuItem x:Name="MenuClose" Header="{loc:S PinClose}" InputGestureText="Esc" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Layered window: WPF composites this, so the Border is the corner. -->
    <Border x:Name="Frame"
            Margin="14"
            CornerRadius="8"
            Background="#111"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <!-- Pinned left to right: a mirrored shot is a wrong shot. -->
        <Image x:Name="Shot" FlowDirection="LeftToRight"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True" />
    </Border>
</Window>
